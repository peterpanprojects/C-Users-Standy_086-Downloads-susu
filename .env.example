
# Supabase project settings (use the anon/public key, never the service-role key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional public Paystack key
VITE_PAYSTACK_PUBLIC_KEY=

# Server-only variables for Vercel API routes. Never use a VITE_ prefix.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=
